<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS launchd job: starts the PAPER engine at 09:05 IST on weekdays (your Mac must use IST).
     Edit the two paths (REPO and WORKDIR), then:
       cp com.trader-india.engine.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.trader-india.engine.plist
     It never starts live mode: live runs are started by you, by hand. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.trader-india.engine</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>REPO/trader-live/live.py</string>
    <string>run</string>
    <string>--mode</string>
    <string>paper</string>
  </array>
  <key>WorkingDirectory</key><string>WORKDIR</string>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>5</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>5</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>5</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>5</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>5</integer></dict>
  </array>
  <key>StandardOutPath</key><string>WORKDIR/trader/live/logs/launchd.out</string>
  <key>StandardErrorPath</key><string>WORKDIR/trader/live/logs/launchd.err</string>
</dict>
</plist>
