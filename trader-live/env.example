# Copy to ~/.config/trader-india/.env and chmod 600 it. Never commit it, never paste it into a chat.
# Upstox developer console: https://account.upstox.com/developer/apps
# Redirect URL in the app must be exactly the same as below.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8765/callback
